# QORVEXA DIGITAL BANK - environment configuration (copy to .env)
NODE_ENV=development
PORT=3000
# Public base URL used in password-reset links
APP_BASE_URL=http://localhost:3000

# PostgreSQL connection
DATABASE_URL=postgres://qorvexa:change_me@localhost:5432/qorvexa
# Set to true when your managed Postgres requires TLS (Render, Railway, Neon...)
DATABASE_SSL=false
# Used by `npm test` (the test suite wipes this database!)
# Apply pending migrations automatically when the server starts.
# Defaults to true when NODE_ENV=production, false otherwise.
AUTO_MIGRATE=false
TEST_DATABASE_URL=postgres://qorvexa:change_me@localhost:5432/qorvexa_test

# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
SESSION_SECRET=replace-with-a-long-random-secret
# Session idle lifetime in minutes (customer + admin)
SESSION_TTL_MINUTES=30
# "Remember me" lifetime in days
REMEMBER_ME_DAYS=14
# Set true when served behind HTTPS (forces Secure cookies). Defaults to true when NODE_ENV=production.
COOKIE_SECURE=false
# Number of reverse proxies in front of the app (Render/Railway: 1)
TRUST_PROXY=0

BCRYPT_ROUNDS=12

# Rate limiting (requests per 15 minutes per IP)
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_GENERAL_MAX=600

# Outgoing email for password-reset links. Leave SMTP_URL empty to write
# messages to the server log instead (development only).
SMTP_URL=
MAIL_FROM="Qorvexa Digital Bank <no-reply@localhost>"
