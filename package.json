    "testTimeout": 30000,
    "globalSetup": "./tests/globalSetup.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "chart.js": "^4.6.1",
    "compression": "^1.8.2",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^18.0.10",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "express-ejs-layouts": "^2.5.1",
    "express-rate-limit": "^8.7.5",
    "express-session": "^1.19.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "morgan": "^1.12.1",
    "nodemailer": "^10.6.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "supertest": "^7.3.2"
  }
