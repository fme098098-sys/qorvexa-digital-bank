<!doctype html>
<html lang="en">
<head><%- include('../partials/head') %></head>
<body class="public">
<%- include('../partials/icons') %>
<header class="navbar" id="top">
  <div class="container nav-inner">
    <a href="/" class="brand"><img src="/static/img/logo.svg" alt="" width="38" height="38"><span>QORVEXA <em>DIGITAL BANK</em></span></a>
    <button class="nav-toggle" type="button" aria-label="Open menu" aria-expanded="false" data-toggle="#main-nav"><%- icon('menu') %></button>
    <nav id="main-nav" class="nav-links">
      <a href="/" class="<%= path === '/' ? 'active' : '' %>">Home</a>
      <a href="/about" class="<%= path === '/about' ? 'active' : '' %>">About</a>
      <a href="/#features">Features</a>
      <a href="/contact" class="<%= path === '/contact' ? 'active' : '' %>">Contact</a>
      <% if (currentUser) { %>
        <a href="/dashboard" class="btn btn-gold btn-sm">My dashboard</a>
      <% } else { %>
        <a href="/login" class="btn btn-outline-light btn-sm">Login</a>
        <a href="/register" class="btn btn-gold btn-sm">Register</a>
      <% } %>
    </nav>
  </div>
</header>
<main>
  <% if (flash) { %><div class="container flash-wrap"><%- include('../partials/flash') %></div><% } %>
  <%- body %>
</main>
<%- include('../partials/site-footer') %>
<script src="/static/js/app.js" defer></script>
</body>
</html>
