<!doctype html>
<html lang="en">
<head><%- include('../partials/head') %></head>
<body class="app admin">
<%- include('../partials/icons') %>
<div class="app-shell">
  <aside class="sidebar sidebar-admin" id="sidebar">
    <a href="/admin" class="brand brand-light"><img src="/static/img/logo.svg" alt="" width="36" height="36"><span>QORVEXA <em>ADMIN CONSOLE</em></span></a>
    <nav class="side-nav">
      <% const ops = currentAdmin.role !== 'support';
      const nav = [ ['/admin','grid','Dashboard', true], ['/admin/users','users','User management', true],
        ['/admin/transactions','list','Transactions', ops], ['/admin/deposits','deposit','Deposit requests', ops],
        ['/admin/support','support','Support management', true], ['/admin/login-activity','eye','Login activity', ops], ['/admin/audit-logs','activity','Activity logs', ops],
        ['/admin/settings','settings','System settings', ops] ];
      nav.filter(function (n) { return n[3]; }).forEach(function (n) {
        const active = path === n[0] || (n[0] !== '/admin' && path.indexOf(n[0]) === 0); %>
        <a href="<%= n[0] %>" class="<%= active ? 'active' : '' %>"><%- icon(n[1]) %><span><%= n[2] %></span>
          <% if (n[0] === '/admin/login-activity' && typeof loginAlerts !== 'undefined' && loginAlerts && loginAlerts.new_devices) { %><b class="badge" title="New-device sign-ins in the last 24 hours"><%= loginAlerts.new_devices %> new</b><% } %></a>
      <% }) %>
    </nav>
    <form method="post" action="/admin/logout" class="side-logout">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="side-link-btn"><%- icon('logout') %><span>Sign out</span></button>
    </form>
  </aside>
  <div class="sidebar-backdrop" data-close-sidebar></div>
  <div class="app-main">
    <header class="topbar">
      <button class="icon-btn sidebar-toggle" type="button" aria-label="Open navigation" data-open-sidebar><%- icon('menu') %></button>
      <h1 class="topbar-title"><%= title %></h1>
      <div class="topbar-right">
        <span class="role-chip"><%- icon('shield') %> <%= fmt.titleCase(currentAdmin.role) %></span>
        <span class="avatar-chip"><span class="avatar avatar-gold"><%= currentAdmin.full_name.split(' ').map(function (p) { return p[0]; }).slice(0, 2).join('').toUpperCase() %></span><span class="avatar-name"><%= currentAdmin.full_name %></span></span>
      </div>
    </header>
    <div class="content">
      <%- include('../partials/flash') %>
      <%- body %>
    </div>
    <%- include('../partials/app-footer') %>
  </div>
</div>
<script src="/static/vendor/chart.umd.js" defer></script>
<script src="/static/js/app.js" defer></script>
</body>
</html>
