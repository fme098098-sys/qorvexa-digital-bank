<section class="profile-head card">
  <span class="avatar lg"><%= user.full_name.split(' ').map(function (p) { return p[0]; }).slice(0, 2).join('') %></span>
  <div class="grow">
    <h2><%= user.full_name %> <span class="status-pill status-<%= user.status %>"><%= fmt.titleCase(user.status) %></span></h2>
    <p class="muted">@<%= user.username %> · <%= user.email %> · <%= user.phone %> · <%= user.country %></p>
    <% if (user.status_reason) { %><p class="small muted">Status note: <%= user.status_reason %></p><% } %>
  </div>
  <div class="profile-balance"><small>Balance</small><strong><%= fmt.formatUSD(account.balance_cents) %></strong><small class="muted">Read-only · changes only via ledger</small></div>
</section>
<div class="page-grid">
  <div class="stack">
    <section class="card">
      <div class="card-head"><h3>Account details</h3></div>
      <dl class="detail-list cols">
        <div><dt>Account ID</dt><dd class="mono"><%= user.customer_id %></dd></div>
        <div><dt>Account number</dt><dd class="mono"><%= account.account_number %></dd></div>
        <div><dt>Account type</dt><dd><%= fmt.titleCase(account.account_type) %></dd></div>
        <div><dt>Account status</dt><dd><%= fmt.titleCase(account.status) %></dd></div>
        <div><dt>Available balance</dt><dd><%= fmt.formatUSD(account.balance_cents - account.hold_cents) %></dd></div>
        <div><dt>Transactions</dt><dd><%= stats.totals.tx_count %></dd></div>
        <div><dt>Total in</dt><dd class="amount-credit"><%= fmt.formatUSD(stats.totals.incoming) %></dd></div>
        <div><dt>Total out</dt><dd class="amount-debit"><%= fmt.formatUSD(stats.totals.outgoing) %></dd></div>
        <div><dt>Registered</dt><dd><%= fmt.formatDate(user.created_at) %></dd></div>
        <div><dt>Last login</dt><dd><%= user.last_login_at ? fmt.formatDate(user.last_login_at) : '—' %></dd></div>
      </dl>
    </section>
    <section class="card">
      <div class="card-head"><h3>Recent transactions</h3><% if (currentAdmin.role !== 'support') { %><a class="link" href="/admin/transactions?q=<%= account.account_number %>">All</a><% } %></div>
      <div class="table-wrap"><table class="table compact">
        <thead><tr><th>Date</th><th>Reference</th><th>Type</th><th class="num">Amount</th><th class="num">Balance</th></tr></thead>
        <tbody>
          <% recent.forEach(function (t) { %>
            <tr><td class="nowrap small"><%= fmt.formatDate(t.created_at) %></td><td class="mono small"><% if (currentAdmin.role !== 'support') { %><a href="/admin/transactions/<%= t.reference %>"><%= t.reference %></a><% } else { %><%= t.reference %><% } %></td>
              <td><span class="type-pill type-<%= t.type %>"><%= TYPE_LABELS[t.type] %></span></td>
              <td class="num amount-<%= t.direction %>"><%= fmt.formatUSD(t.amount_cents) %></td><td class="num"><%= fmt.formatUSD(t.balance_after_cents) %></td></tr>
          <% }) %>
          <% if (!recent.length) { %><tr><td colspan="5" class="center muted">No transactions.</td></tr><% } %>
        </tbody></table></div>
    </section>
    <% if (canSeeLogins) { %>
    <section class="card" id="login-activity">
      <div class="card-head"><h3><%- icon('eye') %> Login activity</h3>
        <span class="muted small"><% const newCount = loginActivity.filter(function (e) { return e.is_new_device; }).length; %><% if (newCount) { %><span class="status-pill status-new-device"><%= newCount %> new device<%= newCount === 1 ? '' : 's' %></span> <% } %><a class="link" href="/admin/login-activity?q=<%= encodeURIComponent(user.username) %>&actor=user">Full history</a></span></div>
      <%- include('_login-table', { events: loginActivity, showWho: false }) %>
    </section>
    <% } %>
    <section class="card">
      <div class="card-head"><h3>Activity for this customer</h3></div>
      <%- include('_logs-table', { logs: logs }) %>
    </section>
  </div>
  <div class="stack">
    <% if (currentAdmin.role !== 'support') { %>
    <section class="card">
      <div class="card-head"><h3><%- icon('user') %> Edit profile</h3></div>
      <%- include('../partials/errors') %>
      <form method="post" action="/admin/users/<%= user.id %>/edit" class="form" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label class="field"><span>Full name</span><input name="fullName" required value="<%= form.full_name %>"></label>
        <label class="field"><span>Email</span><input type="email" name="email" required value="<%= form.email %>"></label>
        <label class="field"><span>Phone</span><input name="phone" required value="<%= form.phone %>"></label>
        <label class="field"><span>Country</span><select name="country"><% countries.forEach(function (c) { %><option value="<%= c %>" <%= form.country === c ? 'selected' : '' %>><%= c %></option><% }) %></select></label>
        <button class="btn btn-primary btn-block" type="submit">Save profile</button>
        <p class="hint"><%- icon('info') %> Profile edits are audit-logged and the customer is notified. Balances and transactions cannot be edited.</p>
      </form>
    </section>
    <section class="card">
      <div class="card-head"><h3><%- icon('shield') %> Account access</h3></div>
      <form method="post" action="/admin/users/<%= user.id %>/status" class="form" data-confirm="<%= user.status === 'active' ? 'Suspend this customer? Their sessions will end immediately.' : 'Reactivate this customer?' %>">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="status" value="<%= user.status === 'active' ? 'suspended' : 'active' %>">
        <label class="field"><span>Reason (recorded in audit log)</span><input name="reason" required minlength="3" maxlength="200"></label>
        <% if (user.status === 'active') { %>
          <button class="btn btn-danger btn-block" type="submit"><%- icon('lock') %> Suspend account</button>
        <% } else { %>
          <button class="btn btn-success btn-block" type="submit"><%- icon('check') %> Reactivate account</button>
        <% } %>
      </form>
    </section>
    <% } %>
    <% if (canSeeLogins) { %>
    <section class="card" id="sessions">
      <div class="card-head"><h3><%- icon('lock') %> Active sessions</h3><span class="muted"><%= sessions.length %></span></div>
      <ul class="req-list session-list">
        <% sessions.forEach(function (s) { %>
          <li><div><strong><%= s.browser || 'Unknown browser' %> on <%= s.os || 'unknown OS' %></strong>
            <small class="muted"><%= fmt.titleCase(s.device_type || 'unknown') %> · IP <span class="mono"><%= s.ip || '—' %></span><br>Signed in <%= s.signed_in_at ? fmt.formatDateTime(s.signed_in_at) : 'before tracking was enabled' %> · expires <%= fmt.formatDateTime(s.expire) %></small></div></li>
        <% }) %>
        <% if (!sessions.length) { %><li class="muted">No active sessions.</li><% } %>
      </ul>
      <form method="post" action="/admin/users/<%= user.id %>/sessions/revoke" class="form" data-confirm="Sign this customer out of every device now? This is recorded in the audit log.">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn btn-danger btn-block" type="submit" <%= sessions.length ? '' : 'disabled' %>><%- icon('logout') %> Sign out all sessions</button>
        <p class="hint"><%- icon('info') %> Ends every session for this customer, notifies them and writes an audit entry.</p>
      </form>
    </section>
    <% } %>
    <section class="card">
      <div class="card-head"><h3>Deposit requests</h3></div>
      <ul class="req-list">
        <% deposits.forEach(function (r) { %>
          <li><div><strong><%= fmt.formatUSD(r.amount_cents) %></strong><small class="muted"><%= r.reference %> · <%= fmt.formatDate(r.created_at, false) %></small></div><span class="status-pill status-<%= r.status %>"><%= fmt.titleCase(r.status) %></span></li>
        <% }) %>
        <% if (!deposits.length) { %><li class="muted">No deposit requests.</li><% } %>
      </ul>
    </section>
  </div>
</div>
