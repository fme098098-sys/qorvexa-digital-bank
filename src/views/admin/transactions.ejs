<section class="stat-grid">
  <div class="stat-card"><small>Total deposits</small><strong><%= fmt.formatUSD(totals.total_deposits) %></strong></div>
  <div class="stat-card"><small>Total withdrawals</small><strong><%= fmt.formatUSD(totals.total_withdrawals) %></strong></div>
  <div class="stat-card"><small>Total transfers</small><strong><%= fmt.formatUSD(totals.total_transfers) %></strong></div>
  <div class="stat-card"><small>Simulated funds held</small><strong><%= fmt.formatUSD(totals.total_funds) %></strong></div>
</section>
<section class="card">
  <form method="get" action="/admin/transactions" class="filter-bar">
    <label class="field grow"><span>Search</span><div class="input-group"><b><%- icon('search') %></b><input name="q" value="<%= filters.q %>" placeholder="Reference, account number, name or description"></div></label>
    <label class="field"><span>Type</span><select name="type"><option value="">All types</option><% Object.keys(TYPE_LABELS).forEach(function (k) { %><option value="<%= k %>" <%= filters.type === k ? 'selected' : '' %>><%= TYPE_LABELS[k] %></option><% }) %></select></label>
    <label class="field"><span>From</span><input type="date" name="from" value="<%= filters.from %>"></label>
    <label class="field"><span>To</span><input type="date" name="to" value="<%= filters.to %>"></label>
    <div class="filter-actions"><button class="btn btn-primary" type="submit"><%- icon('search') %> Search</button><a class="btn btn-ghost" href="/admin/transactions">Reset</a></div>
  </form>
</section>
<section class="card">
  <div class="card-head"><h3>Ledger entries</h3><span class="muted"><%= result.total %> entries · read-only</span></div>
  <div class="table-wrap"><table class="table">
    <thead><tr><th>Date</th><th>Reference</th><th>Account</th><th>Type</th><th class="hide-sm">Description</th><th class="num">Amount</th><th class="num hide-sm">Balance after</th></tr></thead>
    <tbody>
      <% result.rows.forEach(function (t) { %>
        <tr>
          <td class="nowrap small"><%= fmt.formatDate(t.created_at) %></td>
          <td class="mono small"><a href="/admin/transactions/<%= t.reference %>"><%= t.reference %></a></td>
          <td><%= t.owner_name %><small class="muted mono"><%= t.account_number %></small></td>
          <td><span class="type-pill type-<%= t.type %>"><%= TYPE_LABELS[t.type] %></span></td>
          <td class="hide-sm"><%= t.description %><% if (t.counterparty_name) { %><small class="muted"><%= t.direction === 'debit' ? 'To' : 'From' %> <%= t.counterparty_name %></small><% } %></td>
          <td class="num amount-<%= t.direction %>"><%= t.direction === 'credit' ? '+' : '−' %><%= fmt.formatUSD(t.amount_cents) %></td>
          <td class="num hide-sm"><%= fmt.formatUSD(t.balance_after_cents) %></td>
        </tr>
      <% }) %>
      <% if (!result.rows.length) { %><tr><td colspan="7" class="center muted">No transactions match your search.</td></tr><% } %>
    </tbody>
  </table></div>
  <%- include('../partials/pagination', { result: result, query: filters }) %>
</section>
