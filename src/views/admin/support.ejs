<section class="card">
  <form method="get" action="/admin/support" class="filter-bar">
    <label class="field grow"><span>Search</span><div class="input-group"><b><%- icon('search') %></b><input name="q" value="<%= q %>" placeholder="Ticket number, subject, name or email"></div></label>
    <label class="field"><span>Status</span><select name="status"><option value="">All</option><% ['open','in_progress','resolved','closed'].forEach(function (s) { %><option value="<%= s %>" <%= status === s ? 'selected' : '' %>><%= fmt.titleCase(s) %></option><% }) %></select></label>
    <div class="filter-actions"><button class="btn btn-primary" type="submit"><%- icon('search') %> Filter</button><a class="btn btn-ghost" href="/admin/support">Reset</a></div>
  </form>
</section>
<section class="card">
  <div class="card-head"><h3>Support requests</h3><span class="muted"><%= result.total %> tickets</span></div>
  <div class="table-wrap"><table class="table">
    <thead><tr><th>Ticket</th><th>Subject</th><th>From</th><th>Priority</th><th>Status</th><th class="hide-sm">Created</th><th></th></tr></thead>
    <tbody>
      <% result.rows.forEach(function (t) { %>
        <tr>
          <td class="mono small"><%= t.ticket_number %></td>
          <td><strong><%= t.subject %></strong><small class="muted"><%= fmt.titleCase(t.category) %></small></td>
          <td><%= t.name %><small class="muted"><%= t.email %><%= t.user_id ? ' · customer' : ' · website visitor' %></small></td>
          <td><span class="prio prio-<%= t.priority %>"><%= fmt.titleCase(t.priority) %></span></td>
          <td><span class="status-pill status-<%= t.status %>"><%= fmt.titleCase(t.status) %></span></td>
          <td class="hide-sm small nowrap"><%= fmt.formatDate(t.created_at) %></td>
          <td><a class="btn btn-ghost btn-sm" href="/admin/support/<%= t.id %>">Open</a></td>
        </tr>
      <% }) %>
      <% if (!result.rows.length) { %><tr><td colspan="7" class="center muted">No tickets found.</td></tr><% } %>
    </tbody>
  </table></div>
  <%- include('../partials/pagination', { result: result, query: { q: q, status: status } }) %>
</section>
