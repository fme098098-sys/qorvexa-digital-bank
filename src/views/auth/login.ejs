<h1 class="auth-title">Welcome back</h1>
<p class="auth-sub">Sign in to your Qorvexa account.</p>
<%- include('../partials/notice') %>
<%- include('../partials/errors') %>
<form method="post" action="/login" class="form" novalidate>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <label class="field"><span>Email or username</span>
    <input name="identifier" autocomplete="username" required maxlength="254" value="<%= form.identifier || '' %>" autofocus></label>
  <label class="field"><span>Password</span>
    <div class="input-group"><input type="password" name="password" autocomplete="current-password" required maxlength="128">
    <button type="button" class="input-addon" data-toggle-password aria-label="Show password"><%- icon('eye') %></button></div></label>
  <div class="form-row between">
    <label class="check"><input type="checkbox" name="remember" value="1"> <span>Remember me</span></label>
    <a href="/forgot-password">Forgot password?</a>
  </div>
  <button type="submit" class="btn btn-primary btn-block btn-lg"><%- icon('lock') %> Sign in securely</button>
</form>
<p class="auth-switch">New to Qorvexa? <a href="/register">Open an account</a></p>
