<div class="page-grid even">
  <section class="card">
    <div class="card-head"><h3><%- icon('user') %> Personal details</h3></div>
    <%- include('../partials/errors') %>
    <form method="post" action="/profile" class="form" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label class="field"><span>Full name</span><input name="fullName" required maxlength="120" value="<%= form.full_name %>"></label>
      <label class="field"><span>Email address</span><input type="email" name="email" required maxlength="254" value="<%= form.email %>"></label>
      <div class="grid-2">
        <label class="field"><span>Phone number</span><input type="tel" name="phone" required maxlength="20" value="<%= form.phone %>"></label>
        <label class="field"><span>Country</span>
          <select name="country"><% countries.forEach(function (c) { %><option value="<%= c %>" <%= form.country === c ? 'selected' : '' %>><%= c %></option><% }) %></select></label>
      </div>
      <label class="field"><span>Username</span><input value="<%= currentUser.username %>" disabled></label>
      <button type="submit" class="btn btn-primary">Save changes</button>
    </form>
  </section>
  <div class="stack">
    <section class="card">
      <div class="card-head"><h3><%- icon('lock') %> Change password</h3></div>
      <%- include('../partials/errors', { list: pwErrors }) %>
      <form method="post" action="/profile/password" class="form" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label class="field"><span>Current password</span><input type="password" name="currentPassword" autocomplete="current-password" required></label>
        <label class="field"><span>New password</span><input type="password" name="newPassword" autocomplete="new-password" required minlength="10" data-strength></label>
        <div class="strength"><div class="strength-bar"><i></i></div><small>10+ characters, upper &amp; lowercase, number and symbol.</small></div>
        <label class="field"><span>Confirm new password</span><input type="password" name="confirmPassword" autocomplete="new-password" required></label>
        <button type="submit" class="btn btn-navy">Update password</button>
      </form>
    </section>
    <section class="card">
      <div class="card-head"><h3><%- icon('card') %> Account</h3></div>
      <dl class="detail-list">
        <div><dt>Account ID</dt><dd class="mono"><%= currentUser.customer_id %></dd></div>
        <div><dt>Account number</dt><dd class="mono"><%= account.account_number %></dd></div>
        <div><dt>Account type</dt><dd><%= fmt.titleCase(account.account_type) %></dd></div>
        <div><dt>Status</dt><dd><span class="status-pill status-<%= account.status %>"><%= fmt.titleCase(account.status) %></span></dd></div>
        <div><dt>Member since</dt><dd><%= fmt.formatDate(currentUser.created_at, false) %></dd></div>
        <div><dt>Last sign-in</dt><dd><%= currentUser.last_login_at ? fmt.formatDate(currentUser.last_login_at) : '—' %></dd></div>
      </dl>
    </section>
  </div>
</div>
<section class="card" id="sign-ins">
  <div class="card-head"><h3><%- icon('shield') %> Recent sign-ins</h3><span class="muted small">If you don't recognise a sign-in, change your password and sign out other sessions.</span></div>
  <div class="page-grid even">
    <div>
      <div class="table-wrap"><table class="table compact">
        <thead><tr><th>Time</th><th>Device</th><th>IP address</th><th>Result</th></tr></thead>
        <tbody>
          <% signIns.forEach(function (e) { %>
            <tr class="<%= e.success ? '' : 'row-failed' %>">
              <td class="small nowrap"><%= fmt.formatDateTime(e.created_at) %></td>
              <td class="small"><%= e.browser || 'Unknown browser' %> on <%= e.os || 'unknown OS' %> <span class="muted">· <%= fmt.titleCase(e.event === 'login' ? (e.device_type || 'unknown') : e.event) %></span>
                <% if (e.is_new_device) { %><span class="status-pill status-new-device">New device</span><% } %></td>
              <td class="mono small"><%= e.ip || '—' %></td>
              <td><% if (e.success) { %><span class="status-pill status-active">OK</span><% } else { %><span class="status-pill status-suspended">Failed</span><% } %></td>
            </tr>
          <% }) %>
          <% if (!signIns.length) { %><tr><td colspan="4" class="muted center">No sign-in activity yet.</td></tr><% } %>
        </tbody>
      </table></div>
    </div>
    <div>
      <h4>Active sessions</h4>
      <ul class="req-list session-list">
        <% sessions.forEach(function (s) { %>
          <li><div><strong><%= s.browser || 'Unknown browser' %> on <%= s.os || 'unknown OS' %></strong> <% if (s.sid === currentSid) { %><span class="status-pill status-active">This device</span><% } %>
            <small class="muted">IP <span class="mono"><%= s.ip || '—' %></span> · signed in <%= s.signed_in_at ? fmt.formatDateTime(s.signed_in_at) : 'before sign-in tracking was enabled' %></small></div></li>
        <% }) %>
        <% if (!sessions.length) { %><li class="muted">No active sessions.</li><% } %>
      </ul>
      <form method="post" action="/profile/sessions/revoke-others" class="form" data-confirm="Sign out of all other devices?">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn btn-navy" type="submit" <%= sessions.filter(function (s) { return s.sid !== currentSid; }).length ? '' : 'disabled' %>><%- icon('logout') %> Sign out other sessions</button>
      </form>
    </div>
  </div>
</section>
